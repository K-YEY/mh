                PDF, PNG, JPG (Max 20MB)
              </div>
            </label>
          </div>

          <!-- Attached Document Preview Card -->
          <div v-else class="p-4 rounded-xl bg-white border border-zinc-200 flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-lg bg-zinc-100 border border-zinc-200 flex items-center justify-center overflow-hidden shrink-0">
