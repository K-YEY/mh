                {{ isAr ? 'شرط إلزامي لإنشاء الشحنة (Scan or PDF Required)' : 'Mandatory Compliance requirement for Master Shipment initialization' }}
              </span>
            </div>
          </div>
          <span class="px-2.5 py-1 rounded text-[10px] font-mono font-bold uppercase bg-zinc-950 text-white">
            {{ isAr ? 'إلزامي للإنشاء' : 'REQUIRED' }}
          </span>
