              type="file" 
              id="cooFileInput" 
              accept=".pdf,image/png,image/jpeg,image/jpg" 
              class="hidden" 
              @change="handleFileUpload" 
            />
            <label for="cooFileInput" class="cursor-pointer block space-y-2">
              <UploadCloud class="w-8 h-8 text-zinc-400 mx-auto" />
              <div class="text-xs font-bold text-zinc-800">
                {{ isAr ? 'اضغط لاختيار ملف شهادة المنشأ (PDF أو صورة) أو اسحبه هنا' : 'Click to select Certificate of Origin (PDF or Image) or drag & drop' }}
              </div>
              <div class="text-[10px] text-zinc-500">
                PDF, PNG, JPG (Max 20MB)
              </div>
            </label>
          </div>

          <!-- Attached Document Preview Card -->
          <div v-else class="p-4 rounded-xl bg-white border border-zinc-200 flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-lg bg-zinc-100 border border-zinc-200 flex items-center justify-center overflow-hidden shrink-0">
                <img v-if="scannedPreviewUrl" :src="scannedPreviewUrl" alt="COO Preview" class="w-full h-full object-cover" />
                <FileText v-else class="w-6 h-6 text-zinc-700" />
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold text-zinc-950 font-mono">{{ uploadedFileName }}</span>
                  <span class="px-2 py-0.5 rounded text-[9px] font-mono font-bold bg-emerald-100 text-emerald-800 flex items-center gap-1">
                    <CheckCircle2 class="w-3 h-3" />
                    {{ isAr ? 'تم الإرفاق' : 'Attached' }}
                  </span>
                </div>
                <div class="text-[11px] text-zinc-500 font-mono mt-0.5">
                  {{ uploadedFileSize }} • {{ form.coo_scanned_data ? (isAr ? 'مسح ضوئي بالكاميرا' : 'Live Camera Scan') : (isAr ? 'ملف مرفوع' : 'Uploaded File') }}
                </div>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <button 
                type="button" 
                @click="openScanner" 
                class="p-2 text-zinc-600 hover:text-zinc-950 rounded-lg hover:bg-zinc-100 text-xs font-bold transition-colors cursor-pointer"
                :title="isAr ? 'إعادة المسح' : 'Rescan'"
              >
                <RefreshCw class="w-4 h-4" />
              </button>
              <button 
                type="button" 
                @click="removeAttachment" 
                class="p-2 text-red-600 hover:text-red-700 rounded-lg hover:bg-red-50 text-xs font-bold transition-colors cursor-pointer"
                :title="isAr ? 'حذف المرفق' : 'Remove'"
              >
                <Trash2 class="w-4 h-4" />
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Footer -->
      <div class="flex items-center justify-between pt-4 border-t border-zinc-200">
        <div class="text-xs text-zinc-500">
          {{ isAr ? '* الحقول المؤشرة بعلامة حمراء وشهادة المنشأ إلزامية لتأسيس الشحنة الماستر.' : '* Marked fields and Certificate of Origin are required.' }}
        </div>

        <UiButton 
          type="submit" 
          :disabled="form.processing" 
           variant="primary"
        >
          <Ship class="w-4 h-4" />
          <span>{{ isAr ? 'تأسيس وحفظ ملف الشحنة الماستر' : 'Initialize Ocean Master File' }}</span>
        </UiButton>
      </div>
    </form>

    <!-- Interactive Camera Scanner Modal -->
    <div v-if="isScannerOpen" class="fixed inset-0 bg-black/80 z-50 flex items-center justify-center p-4 backdrop-blur-xs">
      <div class="bg-zinc-950 text-white rounded-2xl max-w-2xl w-full overflow-hidden border border-zinc-800 shadow-2xl flex flex-col">
        <!-- Modal Header -->
        <div class="p-4 border-b border-zinc-800 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <Camera class="w-5 h-5 text-emerald-400" />
            <h3 class="font-bold text-sm">
              {{ isAr ? 'المسح الضوئي لشهادة المنشأ (Document Scanner)' : 'Live Document Scanner' }}
            </h3>
          </div>
          <button @click="closeScanner" class="text-zinc-400 hover:text-white p-1 rounded-lg">
            <X class="w-5 h-5" />
          </button>
        </div>

        <!-- Video Viewport / Viewfinder -->
        <div class="relative bg-black flex items-center justify-center min-h-[380px] overflow-hidden">
          <video 
            ref="scannerVideo" 
            autoplay 
            playsinline 
            class="w-full max-h-[460px] object-contain"
          ></video>

          <!-- Document Framing Overlay Guide -->
          <div class="absolute inset-8 border-2 border-emerald-400/80 rounded-xl pointer-events-none flex flex-col justify-between p-3">
            <div class="flex justify-between">
              <div class="w-4 h-4 border-t-2 border-l-2 border-emerald-400"></div>
              <div class="w-4 h-4 border-t-2 border-r-2 border-emerald-400"></div>
            </div>
            <div class="text-center bg-black/60 px-3 py-1 rounded-full self-center text-[11px] font-mono text-emerald-300">
              {{ isAr ? 'ضع شهادة المنشأ داخل الإطار واضغط على التقاط' : 'Align Document inside frame and click capture' }}
            </div>
            <div class="flex justify-between">
              <div class="w-4 h-4 border-b-2 border-l-2 border-emerald-400"></div>
              <div class="w-4 h-4 border-b-2 border-r-2 border-emerald-400"></div>
            </div>
          </div>

          <div v-if="scannerError" class="absolute inset-0 bg-zinc-900/95 flex items-center justify-center p-6 text-center text-red-400 text-xs">
            <div>
              <AlertCircle class="w-8 h-8 mx-auto mb-2 text-red-400" />
              {{ scannerError }}
            </div>
          </div>
        </div>

        <!-- Hidden Canvas for frame snapshot -->
        <canvas ref="scannerCanvas" class="hidden"></canvas>

        <!-- Modal Controls -->
        <div class="p-4 bg-zinc-900 border-t border-zinc-800 flex items-center justify-between">
          <button 
            type="button" 
            @click="closeScanner" 
            class="px-4 py-2 rounded-lg text-xs font-bold text-zinc-300 hover:text-white bg-zinc-800 hover:bg-zinc-700 transition-colors"
          >
            {{ isAr ? 'إلغاء' : 'Cancel' }}
          </button>

          <button 
            type="button" 
            @click="captureScan" 
            :disabled="!!scannerError"
            class="px-6 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-zinc-950 text-xs font-extrabold flex items-center gap-2 cursor-pointer shadow-lg transition-all"
          >
            <Camera class="w-4 h-4" />
            <span>{{ isAr ? 'التقاط وحفظ الصورة (Capture Scan)' : 'Capture Document' }}</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</template>
