<script setup>
import { ref, onBeforeUnmount } from 'vue'
import { useForm, Link } from '@inertiajs/vue3'
import { useI18n } from '@/Composables/useI18n'
import { 
  ArrowLeft, 
  ArrowRight, 
  Camera, 
  UploadCloud, 
  FileText, 
  CheckCircle2, 
  AlertCircle, 
  Trash2, 
  X, 
  RefreshCw,
  Building2,
  Ship,
  ShieldCheck
} from 'lucide-vue-next'

const { isAr } = useI18n()

const props = defineProps({
  shipping_lines: Array,
  customs_brokers: Array,
  truckers: Array,
  ports: Array,
  coo_document_type: Object,
})

const form = useForm({
  direction: 'EXPORT',
  shipment_mode: 'FCL',
  shipping_line_id: '',
  customs_broker_id: '',
  trucker_id: '',
  booking_reference: '',
  master_bl_number: '',
  vessel_name: '',
  voyage_number: '',
  pol_id: '',
  pod_id: '',
  etd: '',
  eta: '',
  // Mandatory Certificate of Origin (COO) Details & Attachment
  coo_type: 'EUR.1',
  coo_reference_number: '',
  chamber_of_commerce: 'الغرفة التجارية المصرية',
  coo_issue_date: new Date().toISOString().slice(0, 10),
  coo_file: null,
  coo_scanned_data: null,
})

// Camera Scanner Modal State
const isScannerOpen = ref(false)
const scannerVideo = ref(null)
const scannerCanvas = ref(null)
const mediaStream = ref(null)
const scannerError = ref('')
const scannedPreviewUrl = ref(null)
const uploadedFileName = ref('')
const uploadedFileSize = ref('')

const openScanner = async () => {
  scannerError.value = ''
  isScannerOpen.value = true

  try {
    const stream = await navigator.mediaDevices.getUserMedia({
      video: {
        facingMode: { ideal: 'environment' },
        width: { ideal: 1920 },
        height: { ideal: 1080 },
      },
    })
    mediaStream.value = stream
    if (scannerVideo.value) {
      scannerVideo.value.srcObject = stream
    }
  } catch (err) {
    scannerError.value = isAr.value
      ? 'تعذر الوصول إلى الكاميرا. يرجى التأكد من إعطاء الصلاحية أو استخدام رفع ملف PDF.'
      : 'Could not access camera. Please allow camera access or upload a file directly.'
  }
}

const closeScanner = () => {
  if (mediaStream.value) {
    mediaStream.value.getTracks().forEach((track) => track.stop())
    mediaStream.value = null
  }
  isScannerOpen.value = false
}

const captureScan = () => {
  if (!scannerVideo.value) return

  const video = scannerVideo.value
  const canvas = scannerCanvas.value || document.createElement('canvas')
  canvas.width = video.videoWidth || 1280
  canvas.height = video.videoHeight || 720

  const ctx = canvas.getContext('2d')
  ctx.drawImage(video, 0, 0, canvas.width, canvas.height)

  const dataUrl = canvas.toDataURL('image/jpeg', 0.92)
  form.coo_scanned_data = dataUrl
  form.coo_file = null
  scannedPreviewUrl.value = dataUrl
  uploadedFileName.value = `Scanned_COO_${new Date().getTime()}.jpg`
  uploadedFileSize.value = `${Math.round((dataUrl.length * 0.75) / 1024)} KB`

  closeScanner()
}

const handleFileUpload = (event) => {
  const file = event.target.files[0]
  if (file) {
    form.coo_file = file
    form.coo_scanned_data = null
    uploadedFileName.value = file.name
    uploadedFileSize.value = `${(file.size / 1024).toFixed(1)} KB`

    if (file.type.startsWith('image/')) {
      scannedPreviewUrl.value = URL.createObjectURL(file)
    } else {
      scannedPreviewUrl.value = null
    }
  }
}

const removeAttachment = () => {
  form.coo_file = null
  form.coo_scanned_data = null
  scannedPreviewUrl.value = null
  uploadedFileName.value = ''
  uploadedFileSize.value = ''
}

onBeforeUnmount(() => {
  if (mediaStream.value) {
    mediaStream.value.getTracks().forEach((track) => track.stop())
  }
})

const submit = () => {
  form.post(route('master-shipments.store'), {
    forceFormData: true,
  })
}
</script>

