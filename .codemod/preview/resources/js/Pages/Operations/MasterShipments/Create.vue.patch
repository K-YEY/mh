            </label>
            <select v-model="form.coo_type" class="shadcn-input font-bold" required>
              <option value="EUR.1">{{ isAr ? 'يورو 1 (EUR.1 - الاتحاد الأوروبي)' : 'EUR.1 (European Union)' }}</option>
