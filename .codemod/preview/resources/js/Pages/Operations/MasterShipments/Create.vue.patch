          <!-- POL -->
          <div>
            <label class="block text-xs font-bold text-zinc-800 mb-1">
              {{ isAr ? 'ميناء القيام / الشحن (POL)' : 'Port of Loading (POL)' }}
              <span class="text-red-500">*</span>
