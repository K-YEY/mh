              <th rowspan="2" class="p-3 border-r border-zinc-200 text-center">{{ isAr ? 'التصنيف' : 'Type' }}</th>
              <th colspan="2" class="p-2 border-r border-zinc-200 text-center bg-zinc-200/60">{{ isAr ? 'الرصيد الافتتاحي' : 'Opening Balance' }}</th>
              <th colspan="2" class="p-2 border-r border-zinc-200 text-center bg-blue-50/70 text-blue-900">{{ isAr ? 'حركة الفترة' : 'Period Movement' }}</th>
              <th colspan="2" class="p-2 text-center bg-emerald-50/70 text-emerald-900">{{ isAr ? 'الرصيد الختامي' : 'Ending Balance' }}</th>
            </tr>
            <tr class="border-t border-zinc-200 text-[9px]">
              <th class="p-2 text-right border-r border-zinc-200">{{ isAr ? 'مدين' : 'Debit' }}</th>
              <th class="p-2 text-right border-r border-zinc-200">{{ isAr ? 'دائن' : 'Credit' }}</th>
              <th class="p-2 text-right border-r border-zinc-200 text-blue-900">{{ isAr ? 'مدين' : 'Debit' }}</th>
              <th class="p-2 text-right border-r border-zinc-200 text-blue-900">{{ isAr ? 'دائن' : 'Credit' }}</th>
              <th class="p-2 text-right border-r border-zinc-200 text-emerald-900">{{ isAr ? 'مدين' : 'Debit' }}</th>
              <th class="p-2 text-right text-emerald-900">{{ isAr ? 'دائن' : 'Credit' }}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200 font-mono text-[11px]">
            <tr v-for="acc in report" :key="acc.id" class="hover:bg-blue-50/30 transition-colors">
              <td class="p-2.5 font-bold text-blue-900 border-r border-zinc-100">
                {{ acc.code }}
              </td>
              <td class="p-2.5 font-sans font-semibold text-zinc-900 border-r border-zinc-100">
                {{ isAr ? acc.name_ar : acc.name_en }}
              </td>
              <td class="p-2 text-center border-r border-zinc-100">
                <span 
                  class="px-2 py-0.5 rounded text-[9px] font-bold border font-sans"
                  :class="getTypeLabel(acc.type).color"
                >
                  {{ isAr ? getTypeLabel(acc.type).ar : getTypeLabel(acc.type).en }}
                </span>
              </td>

              <!-- Opening Dr / Cr -->
              <td class="p-2.5 text-right border-r border-zinc-100 text-zinc-600">
                {{ formatMoney(acc.opening_debit) }}
              </td>
              <td class="p-2.5 text-right border-r border-zinc-100 text-zinc-600">
                {{ formatMoney(acc.opening_credit) }}
              </td>

              <!-- Period Dr / Cr -->
              <td class="p-2.5 text-right border-r border-zinc-100 font-bold text-zinc-900">
                {{ formatMoney(acc.period_debit) }}
              </td>
              <td class="p-2.5 text-right border-r border-zinc-100 font-bold text-zinc-900">
                {{ formatMoney(acc.period_credit) }}
              </td>

              <!-- Ending Dr / Cr -->
              <td class="p-2.5 text-right border-r border-zinc-100 font-extrabold text-emerald-900">
                {{ formatMoney(acc.ending_debit) }}
              </td>
              <td class="p-2.5 text-right font-extrabold text-emerald-900">
                {{ formatMoney(acc.ending_credit) }}
              </td>
            </tr>

            <tr v-if="!report?.length">
              <td colspan="9" class="p-8 text-center text-zinc-500 font-sans">
                {{ isAr ? 'لا توجد حسابات أو حركات مسجلة' : 'No accounts or transactions found for selected filters.' }}
              </td>
            </tr>
          </tbody>

          <!-- Grand Totals Footer -->
          <tfoot class="bg-zinc-100 font-mono font-extrabold text-xs border-t-2 border-zinc-300">
            <tr>
              <td colspan="3" class="p-3 text-zinc-900 font-sans uppercase">
                {{ isAr ? 'الإجمالي العام للميزان (Grand Total):' : 'Grand Total:' }}
              </td>
              <td class="p-3 text-right border-r border-zinc-200">
                {{ formatMoney(totals?.opening_debit) }}
              </td>
              <td class="p-3 text-right border-r border-zinc-200">
                {{ formatMoney(totals?.opening_credit) }}
              </td>
              <td class="p-3 text-right border-r border-zinc-200 text-blue-900">
                {{ formatMoney(totals?.period_debit) }}
              </td>
              <td class="p-3 text-right border-r border-zinc-200 text-blue-900">
                {{ formatMoney(totals?.period_credit) }}
              </td>
              <td class="p-3 text-right border-r border-zinc-200 text-emerald-900">
                {{ formatMoney(totals?.ending_debit) }}
              </td>
              <td class="p-3 text-right text-emerald-900">
                {{ formatMoney(totals?.ending_credit) }}
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
</template>
